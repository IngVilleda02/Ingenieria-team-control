# ── Base de datos ─────────────────────────────────────────────
# Vacío  → base local PGlite en ./data/pglite (laptop, sin instalar nada)
# Con URL → PostgreSQL en la nube (Neon). Vercel la llena sola al conectar Neon.
DATABASE_URL=

# ── Sesión ────────────────────────────────────────────────────
# Cadena aleatoria de 32+ caracteres. Genera una con:  npx tsx scripts/secret.ts
# En la laptop es opcional (se crea sola en data/auth-secret). En Vercel es obligatoria.
AUTH_SECRET=

# ── IA (opcional) ─────────────────────────────────────────────
# Sin clave: modo básico local (desglose y plan del día por reglas; el chat queda desactivado).
# Clave gratuita de Gemini: https://aistudio.google.com → Get API key
AI_PROVIDER=gemini          # gemini | groq | ollama | openai
AI_API_KEY=
AI_MODEL=                   # vacío = modelo por defecto del proveedor
# AI_BASE_URL=              # solo si usas un servidor compatible con OpenAI propio

# ── Evidencias en la nube (Vercel) ────────────────────────────
# Lo crea Vercel al conectar Blob Storage. En la laptop se usa data/evidence.
BLOB_READ_WRITE_TOKEN=

# ── Recordatorios automáticos (Vercel Cron) ───────────────────
CRON_SECRET=

# ── Multiusuario (futuro) ─────────────────────────────────────
# true = permite crear cuentas de colaborador y supervisor desde Configuración.
MULTIUSER_ENABLED=false
